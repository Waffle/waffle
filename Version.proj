<?xml version="1.0" encoding="utf-8"?>
<Project DefaultTargets="version" xmlns="http://schemas.microsoft.com/developer/msbuild/2003" >
  <Target Name="version">
    <PropertyGroup>
      <Version>$(MajorVersion).$(MinorVersion).$(RevisionVersion)</Version>
    </PropertyGroup>

    <Message Text="Version: $(Version).0"/>

    <ItemGroup>
      <AssemblyInfoLines Include="[assembly: System.Reflection.AssemblyCompany(&quot;$(CompanyName)&quot;)]" />
      <AssemblyInfoLines Include="[assembly: System.Reflection.AssemblyProduct(&quot;$(ProductName)&quot;)]" />
      <AssemblyInfoLines Include="[assembly: System.Reflection.AssemblyCopyright(&quot;$(Copyright)&quot;)]" />
      <AssemblyInfoLines Include="[assembly: System.Reflection.AssemblyTrademark(&quot;$(Trademark)&quot;)]" />
      <AssemblyInfoLines Include="[assembly: System.Runtime.InteropServices.ComVisible(false)]" />
      <AssemblyInfoLines Include="[assembly: System.CLSCompliant(false)]" />
      <AssemblyInfoLines Include="[assembly: System.Reflection.AssemblyVersion(&quot;$(Version).0&quot;)]" />
      <AssemblyInfoLines Include="[assembly: System.Reflection.AssemblyFileVersion(&quot;$(Version).0&quot;)]" />
    </ItemGroup>

    <WriteLinesToFile
      File="Source\Common\GlobalAssemblyInfo.cs"
      Lines="@(AssemblyInfoLines)"
      Overwrite="true" />

    <ItemGroup>
      <VersionWxiLines Include="&lt;?xml version=&quot;1.0&quot; encoding=&quot;utf-8&quot;?&gt;" />
      <VersionWxiLines Include="&lt;Include&gt;" />
      <VersionWxiLines Include=" &lt;?define ProductVersion=&quot;$(Version).0&quot; ?&gt;" />
      <VersionWxiLines Include=" &lt;?define CompanyName=&quot;$(CompanyName)&quot; ?&gt;" />
      <VersionWxiLines Include=" &lt;?define Copyright=&quot;$(Copyright)&quot; ?&gt;" />
      <VersionWxiLines Include=" &lt;?define Trademark=&quot;$(Trademark)&quot; ?&gt;" />
      <VersionWxiLines Include=" &lt;?define ProductName=&quot;$(ProductName)&quot; ?&gt;" />
      <VersionWxiLines Include=" &lt;?define MSBuildProjectDirectory=&quot;$(MSBuildProjectDirectory)&quot; ?&gt;" />
      <VersionWxiLines Include=" &lt;?ifndef Configuration ?&gt;" />
      <VersionWxiLines Include="  &lt;?define Configuration=&quot;$(Configuration)&quot; ?&gt;" />
      <VersionWxiLines Include=" &lt;?endif?&gt;" />
      <VersionWxiLines Include="&lt;/Include&gt;" />
    </ItemGroup>

    <WriteLinesToFile
      File="Source\Version\Version.wxi"
      Lines="@(VersionWxiLines)"
      Overwrite="true" />

    <ItemGroup>
      <VersionPropertiesLines Include="product.name=$(ProductName)" />
      <VersionPropertiesLines Include="product.version=$(Version).0" />
      <VersionPropertiesLines Include="company.name=$(CompanyName)" />
      <VersionPropertiesLines Include="copyright.text=$(Copyright)" />
      <VersionPropertiesLines Include="trademark.text=$(Trademark)" />
    </ItemGroup>

    <WriteLinesToFile
      File="Source\Version\Version.properties"
      Lines="@(VersionPropertiesLines)"
      Overwrite="true" />
  </Target>
</Project>
